@prefix hpao: <http://med2rdf.org/hpa/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://med2rdf.org/hpa/ontology> a owl:Ontology ;
    rdfs:label "Human Protein Atlas RNA specificity ontology" ;
    rdfs:comment "Vocabulary for HPA RNA tissue / single cell type / single cell type group specificity." .

### Classes

hpao:AnatomicalEntity a owl:Class ;
    rdfs:label "HPA anatomical entity" .

hpao:Tissue a owl:Class ;
    rdfs:subClassOf hpao:AnatomicalEntity ;
    rdfs:label "HPA tissue" ;
    rdfs:comment "A (consolidated) tissue used in the HPA RNA tissue specificity classification. Each tissue is also an owl:Class (punning)." .

hpao:SingleCellType a owl:Class ;
    rdfs:subClassOf hpao:AnatomicalEntity ;
    rdfs:label "HPA single cell type" ;
    rdfs:comment "A cell type used in the HPA RNA single cell type specificity classification. Each cell type is also an owl:Class, rdfs:subClassOf its single cell type group." .

hpao:SingleCellTypeGroup a owl:Class ;
    rdfs:subClassOf hpao:AnatomicalEntity ;
    rdfs:label "HPA single cell type group" ;
    rdfs:comment "A group of single cell types used in the HPA RNA single cell type group specificity classification (\"cell type group\" in HPA). Single cell types are rdfs:subClassOf their group." .

hpao:SingleCellTypeClass a owl:Class ;
    rdfs:subClassOf hpao:AnatomicalEntity ;
    rdfs:label "HPA single cell type class" ;
    rdfs:comment "A class of single cell type groups (\"cell type class\" in HPA). Single cell type groups are rdfs:subClassOf their class. Not used in the specificity classification." .

hpao:SpecificityCategory a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "RNA specificity category" .

hpao:DistributionCategory a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "RNA distribution category" .

### Gene -> anatomical entity

hpao:enrichedIn a owl:ObjectProperty ;
    rdfs:label "enriched in" ;
    rdfs:range hpao:AnatomicalEntity ;
    rdfs:comment "At least four-fold higher mRNA level in this tissue / cell type / cell type group compared to any other (Tissue enriched / Cell type enriched)." .

hpao:coEnrichedIn a owl:ObjectProperty ;
    rdfs:label "co-enriched in" ;
    rdfs:range hpao:AnatomicalEntity ;
    rdfs:comment "Member of a small set of tissues / cell types / cell type groups with at least four-fold higher mean mRNA level compared to any other (\"Group enriched\" in HPA; renamed so that \"group\" only means a cell type group). See hpao:CoEnriched." .

hpao:enhancedIn a owl:ObjectProperty ;
    rdfs:label "enhanced in" ;
    rdfs:range hpao:AnatomicalEntity ;
    rdfs:comment "At least four-fold higher mRNA level in this tissue / cell type / cell type group compared to the mean of all (Tissue enhanced / Cell type enhanced)." .

### Gene -> category / score

hpao:tissueSpecificity a owl:ObjectProperty ;
    rdfs:label "RNA tissue specificity" ;
    rdfs:range hpao:SpecificityCategory .

hpao:tissueDistribution a owl:ObjectProperty ;
    rdfs:label "RNA tissue distribution" ;
    rdfs:range hpao:DistributionCategory .

hpao:tissueSpecificityScore a owl:DatatypeProperty ;
    rdfs:label "RNA tissue specificity score" ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Fold change to the next highest tissue; given for Tissue enriched and Group enriched genes only." .

hpao:cellTypeSpecificity a owl:ObjectProperty ;
    rdfs:label "RNA single cell type specificity" ;
    rdfs:range hpao:SpecificityCategory .

hpao:cellTypeDistribution a owl:ObjectProperty ;
    rdfs:label "RNA single cell type distribution" ;
    rdfs:range hpao:DistributionCategory .

hpao:cellTypeSpecificityScore a owl:DatatypeProperty ;
    rdfs:label "RNA single cell type specificity score" ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Fold change to the next highest cell type; given for Cell type enriched and Group enriched genes only." .

hpao:cellTypeGroupSpecificity a owl:ObjectProperty ;
    rdfs:label "RNA single cell type group specificity" ;
    rdfs:range hpao:SpecificityCategory .

hpao:cellTypeGroupDistribution a owl:ObjectProperty ;
    rdfs:label "RNA single cell type group distribution" ;
    rdfs:range hpao:DistributionCategory .

hpao:cellTypeGroupSpecificityScore a owl:DatatypeProperty ;
    rdfs:label "RNA single cell type group specificity score" ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Fold change to the next highest cell type group; given for Cell type enriched and Group enriched genes only." .

### Expression values

hpao:RNAExpression a owl:Class ;
    rdfs:label "RNA expression value" ;
    rdfs:comment "Normalized RNA expression of a gene in a tissue or single cell type. Given only for the tissues / cell types / cell type groups a gene is enriched, co-enriched or enhanced in (RNA tissue specific nTPM / RNA single cell type [group] specific nCPM)." .

hpao:rnaExpression a owl:ObjectProperty ;
    rdfs:label "RNA expression" ;
    rdfs:range hpao:RNAExpression .

hpao:anatomicalEntity a owl:ObjectProperty ;
    rdfs:label "anatomical entity" ;
    rdfs:domain hpao:RNAExpression ;
    rdfs:range hpao:AnatomicalEntity .

hpao:nTPM a owl:DatatypeProperty ;
    rdfs:label "nTPM" ;
    rdfs:domain hpao:RNAExpression ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Normalized transcripts per million (tissue)." .

hpao:nCPM a owl:DatatypeProperty ;
    rdfs:label "nCPM" ;
    rdfs:domain hpao:RNAExpression ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Normalized counts per million (single cell type)." .

### Specificity categories (shared by tissue, single cell type and single cell type group;
### the level is given by the predicate, e.g. hpao:tissueSpecificity)

hpao:SpecificityScheme a skos:ConceptScheme ;
    rdfs:label "RNA specificity" .

hpao:Enriched a hpao:SpecificityCategory ;
    skos:inScheme hpao:SpecificityScheme ;
    skos:prefLabel "Enriched" ;
    skos:altLabel "Tissue enriched" , "Cell type enriched" ;
    skos:definition "At least four-fold higher mRNA level in one tissue / cell type / cell type group compared to any other." .
hpao:CoEnriched a hpao:SpecificityCategory ;
    skos:inScheme hpao:SpecificityScheme ;
    skos:prefLabel "Co-enriched" ;
    skos:altLabel "Group enriched" ;
    skos:definition "At least four-fold higher mean mRNA level in a small set of tissues / cell types / cell type groups compared to any other." ;
    rdfs:comment "\"Group enriched\" in HPA. Set size in v25.1: 2-5 tissues, 2-15 cell types (mostly up to 10), 2-5 cell type groups." .
hpao:Enhanced a hpao:SpecificityCategory ;
    skos:inScheme hpao:SpecificityScheme ;
    skos:prefLabel "Enhanced" ;
    skos:altLabel "Tissue enhanced" , "Cell type enhanced" ;
    skos:definition "At least four-fold higher mRNA level in a tissue / cell type / cell type group compared to the mean of all." .
hpao:LowSpecificity a hpao:SpecificityCategory ;
    skos:inScheme hpao:SpecificityScheme ;
    skos:prefLabel "Low specificity" ;
    skos:altLabel "Low tissue specificity" , "Low cell type specificity" ;
    skos:definition "Detected, but not enriched, co-enriched or enhanced." .

### Distribution categories (shared by tissue, single cell type and single cell type group)

hpao:DistributionScheme a skos:ConceptScheme ;
    rdfs:label "RNA distribution" .

hpao:DetectedInAll a hpao:DistributionCategory ;
    skos:inScheme hpao:DistributionScheme ; skos:prefLabel "Detected in all" .
hpao:DetectedInMany a hpao:DistributionCategory ;
    skos:inScheme hpao:DistributionScheme ; skos:prefLabel "Detected in many" .
hpao:DetectedInSome a hpao:DistributionCategory ;
    skos:inScheme hpao:DistributionScheme ; skos:prefLabel "Detected in some" .
hpao:DetectedInSingle a hpao:DistributionCategory ;
    skos:inScheme hpao:DistributionScheme ; skos:prefLabel "Detected in single" .

### Used as both specificity and distribution category

hpao:NotDetected a hpao:SpecificityCategory , hpao:DistributionCategory ;
    skos:inScheme hpao:SpecificityScheme , hpao:DistributionScheme ;
    skos:prefLabel "Not detected" ;
    skos:definition "Not detected in any tissue / cell type / cell type group." .
